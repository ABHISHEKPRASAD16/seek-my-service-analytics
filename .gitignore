# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# Secrets
#
# Nothing in this repository needs credentials today. This entry is here so
# that stays true when someone wires up a real warehouse connection.
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
credentials.json
secrets.toml

# ---------------------------------------------------------------------------
# Report build
#
# The generator script and its outputs are tracked; its dependencies are not.
# `cd build && npm install docx && node build_report.js` reproduces the Word
# file, and to_pdf.ps1 exports the PDF through Word.
# ---------------------------------------------------------------------------
build/node_modules/
build/package-lock.json
